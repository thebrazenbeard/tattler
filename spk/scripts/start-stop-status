#!/bin/sh
set -eu

PIDFILE="${SYNOPKG_PKGVAR}/tattler.pid"
STATE_DIR="${SYNOPKG_PKGVAR}/state"
LOGFILE="${SYNOPKG_PKGVAR}/tattler.log"
BIN="${SYNOPKG_PKGDEST}/bin/tattler"

is_running() {
    [ -f "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

case "${1:-}" in
    start)
        if is_running; then exit 0; fi
        umask 077
        mkdir -p "$STATE_DIR"
        nohup "$BIN" --listen 127.0.0.1:9147 --state-dir "$STATE_DIR" --poll 1s >>"$LOGFILE" 2>&1 &
        echo "$!" >"$PIDFILE"
        sleep 1
        is_running
        ;;
    stop)
        if ! is_running; then rm -f "$PIDFILE"; exit 0; fi
        pid="$(cat "$PIDFILE")"
        kill -TERM "$pid" 2>/dev/null || true
        i=0
        while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do sleep 1; i=$((i+1)); done
        if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || true; fi
        rm -f "$PIDFILE"
        ;;
    status)
        is_running
        ;;
    *)
        echo "usage: $0 {start|stop|status}" >&2
        exit 2
        ;;
esac
