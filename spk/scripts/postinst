#!/bin/sh
set -eu

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

[ "$(id -u)" = "0" ] || {
    echo "Tattler bridge bootstrap must run as root." >&2
    exit 1
}

SRC_DIR="$SYNOPKG_PKGDEST/share/tattler-pkgctl"
HELPER_SRC="$SRC_DIR/tattler-pkgctl"
SIGNERS_SRC="$SRC_DIR/allowed_signers"
SUDOERS_SRC="$SRC_DIR/sudoers.tattler-pkgctl"

HELPER_SHA="ad9b2293cb38d0da40795ae35072321dcf1424fc97c7c835b077346cc1e36c92"
SIGNERS_SHA="55743ac5c384b36c93cb750bcf1ef25eba7aaa8ee71603e416fa64eb7fa5e14a"
SUDOERS_SHA="540edec8e2c4a4b002a52d9a42c1e502a3273ead6821760a11c4d969d6c9c919"

verify_source() {
    path="$1"
    expected="$2"
    label="$3"
    [ -f "$path" ] && [ ! -L "$path" ] || {
        echo "Missing or unsafe $label source: $path" >&2
        exit 1
    }
    actual="$(sha256sum "$path" | awk '{print $1}')"
    [ "$actual" = "$expected" ] || {
        echo "$label source hash mismatch." >&2
        exit 1
    }
}

verify_source "$HELPER_SRC" "$HELPER_SHA" "helper"
verify_source "$SIGNERS_SRC" "$SIGNERS_SHA" "signer policy"
verify_source "$SUDOERS_SRC" "$SUDOERS_SHA" "sudoers policy"

install -d -o root -g root -m 0755 /usr/local/share/tattler-pkgctl
install -o root -g root -m 0755 "$HELPER_SRC" /usr/local/sbin/tattler-pkgctl
install -o root -g root -m 0644 "$SIGNERS_SRC" /usr/local/share/tattler-pkgctl/allowed_signers

install -d -o psims85 -g users -m 0700 /volume1/homes/psims85/.tattler-upload

new_sudoers="/var/tmp/tattler-pkgctl.sudoers.$$"
old_sudoers="/var/tmp/tattler-pkgctl.sudoers.old.$$"
trap 'rm -f "$new_sudoers" "$old_sudoers"' EXIT HUP INT TERM

install -o root -g root -m 0440 "$SUDOERS_SRC" "$new_sudoers"

had_old=0
if [ -f /etc/sudoers.d/tattler-pkgctl ]; then
    cp -p /etc/sudoers.d/tattler-pkgctl "$old_sudoers"
    had_old=1
fi

mv -f "$new_sudoers" /etc/sudoers.d/tattler-pkgctl
chown root:root /etc/sudoers.d/tattler-pkgctl
chmod 0440 /etc/sudoers.d/tattler-pkgctl

if ! /usr/bin/sudo -l -U psims85 >/dev/null 2>&1; then
    rm -f /etc/sudoers.d/tattler-pkgctl
    if [ "$had_old" = "1" ]; then
        mv -f "$old_sudoers" /etc/sudoers.d/tattler-pkgctl
    fi
    echo "Tattler bridge sudoers validation failed; policy rolled back." >&2
    exit 1
fi

logger -t tattler-pkgctl -- "BOOTSTRAP bridge=installed operator=psims85 signer=SHA256:ooKT0ZZErpgzZjQe9mFB26Lkl1bQpGeOkukBCbF2Gm8" 2>/dev/null || true
exit 0
